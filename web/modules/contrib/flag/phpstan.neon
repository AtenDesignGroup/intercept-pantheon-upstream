parameters:
  reportUnmatchedIgnoredErrors: false
  level: 2
  ignoreErrors:
    # new static() is a best practice in Drupal, so we cannot fix that.
    - "#^Unsafe usage of new static#"
    # ObjectProphecy objects are doubles for other classes.
    - "#^Call to an undefined method Prophecy#"
    # Ignore Drupal 10 undefined methods
    - '#Call to an undefined method .*::waitForElementRemoved\(\)#'
    - '#Call to an undefined method .*::waitForElementVisible\(\)#'
    - '#Call to an undefined method .*::assertNoElementAfterWait\(\)#'
    # Ignore Drupal 10 LegacyHook and Hook warning.
    - '#^Attribute class Drupal\\Core\\Hook\\Attribute\\LegacyHook does not exist#'
    - '#^Attribute class Drupal\\Core\\Hook\\Attribute\\Hook does not exist#'
