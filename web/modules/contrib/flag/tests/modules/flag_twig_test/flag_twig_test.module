use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\flag_twig_test\Hook\FlagTwigTestHooks;

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function flag_twig_test_theme($existing, $type, $theme, $path) {
  return \Drupal::service(FlagTwigTestHooks::class)->theme($existing, $type, $theme, $path);
}
